@page
@model Gift_of_the_Givers_Relief_App.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section class="section">
    <div class="container" style="max-width:560px;">
        <div class="card" style="border-radius:12px;">
            <div class="card-body">
                <h2 class="section-title" style="margin-top:0;">Create an account</h2>
                <p class="text-muted">Register to access additional features. Password must be at least 6 characters.</p>

                <form method="post" class="mt-3">
                    <div class="mb-3">
                        <label class="label">First name</label>
                        <input class="input form-control w-100" asp-for="Input.FirstName" />
                        <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Last name</label>
                        <input class="input form-control w-100" asp-for="Input.LastName" />
                        <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Email</label>
                        <input class="input form-control w-100" asp-for="Input.Email" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Password</label>
                        <input class="input form-control w-100" asp-for="Input.Password" type="password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Confirm password</label>
                        <input class="input form-control w-100" asp-for="Input.ConfirmPassword" type="password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary-accent" type="submit">Register</button>
                    </div>

                    <div class="mt-3 text-center">
                        <a asp-page="/Account/Login">Already have an account? Sign in</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}