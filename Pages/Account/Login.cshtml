@page
@model Gift_of_the_Givers_Relief_App.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<section class="section">
    <div class="container" style="max-width:480px;">
        <div class="card" style="border-radius:12px;">
            <div class="card-body">
                <h2 class="section-title" style="margin-top:0;">Sign in</h2>
                <p class="text-muted">Sign in to your account.</p>

                <form method="post" class="mt-3">
                    <div class="mb-3">
                        <label class="label">Email</label>
                        <input class="input form-control w-100" asp-for="Input.Email" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Password</label>
                        <input class="input form-control w-100" asp-for="Input.Password" type="password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary-accent" type="submit">Login</button>
                    </div>

                    <div class="mt-3 text-center small text-muted">
                        <div><a asp-page="/Account/Register">Create an account</a></div>
                        <div class="mt-2"><strong>Demo employee</strong> — <code>employee@demo.local</code> / <code>DemoPass123!</code></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}