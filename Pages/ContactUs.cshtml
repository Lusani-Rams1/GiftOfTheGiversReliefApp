@page
@model Gift_of_the_Givers_Relief_App.Pages.ContactUsModel
@{
    ViewData["Title"] = "Contact Us";
}

<section class="section">
    <h2 class="section-title">Contact Us</h2>

    <div style="max-width:720px;margin:0 auto;background:#fff;padding:1.25rem;border-radius:8px;">
        <p><strong>Email:</strong> <a href="mailto:@Model.Email">@Model.Email</a></p>
        <p><strong>Phone:</strong> <a href="tel:@Model.Phone">@Model.Phone</a></p>
        <p><strong>Address:</strong><br />@Model.Address</p>
    </div>
</section>