@page
@model Gift_of_the_Givers_Relief_App.Pages.ContactUsModel
@{
    ViewData["Title"] = "Contact Us";
}

<section class="section">
    <div class="container" style="max-width:720px;">
        <div class="card" style="border-radius:12px;">
            <div class="card-body">
                <h2 class="section-title" style="margin-top:0;">Contact Us</h2>
                <p class="text-muted">Get in touch — our team will respond during working hours.</p>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Email</h5>
                        <p><a href="mailto:@Model.Email">@Model.Email</a></p>

                        <h5 class="mt-3">Phone</h5>
                        <p><a href="tel:@Model.Phone">@Model.Phone</a></p>
                    </div>

                    <div class="col-md-6">
                        <h5>Address</h5>
                        <p>@Model.Address</p>
                    </div>
                </div>

                <div class="mt-3 text-muted small">
                    <p>Please note: this contact page is informational in the prototype and does not submit messages.</p>
                </div>
            </div>
        </div>
    </div>
</section>