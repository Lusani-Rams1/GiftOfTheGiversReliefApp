@page
@model Gift_of_the_Givers_Relief_App.Pages.Donators.Donators_formModel
@{
    ViewData["Title"] = "Donate";
}

<section class="section">
    <div class="container" style="max-width:720px;">
        <div class="card" style="border-radius:12px;">
            <div class="card-body">
                <h2 class="section-title" style="margin-top:0;">Donate</h2>
                <p class="text-muted">Make a secure donation to support relief efforts. Fields marked with * are required.</p>

                <form method="post" class="mt-3">
                    <div class="mb-3">
                        <label class="label">Full Name*</label>
                        <input class="input form-control w-100" name="FullName" required />
                    </div>

                    <div class="mb-3">
                        <label class="label">Email*</label>
                        <input class="input form-control w-100" type="email" name="Email" required />
                    </div>

                    <div class="mb-3">
                        <label class="label">Phone Number (optional)</label>
                        <input class="input form-control w-100" type="tel" name="PhoneNumber" />
                    </div>

                    <div class="mb-3">
                        <label class="label">Donation Amount (ZAR)*</label>
                        <input class="input form-control w-100" type="number" name="Amount" min="10" step="0.01" required />
                    </div>

                    <div class="mb-3">
                        <label class="label">Which cause?*</label>
                        <select class="input form-select w-100" name="DisasterId">
                            <option value="">General Fund</option>
                            <option value="1">KwaZulu-Natal Floods</option>
                            <option value="2">Western Cape Wildfires</option>
                            <option value="3">Eastern Cape Drought</option>
                        </select>
                    </div>

                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" name="IsAnonymous" id="isAnon" />
                        <label class="form-check-label" for="isAnon">Donate anonymously</label>
                    </div>

                    <div class="mb-3">
                        <label class="label">Message (optional)</label>
                        <textarea class="input form-control w-100" name="Message" maxlength="500"></textarea>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary-accent" type="submit">Donate Now</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
