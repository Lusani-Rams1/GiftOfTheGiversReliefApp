@page
@model Gift_of_the_Givers_Relief_App.Pages.Donators.Donators_formModel
@{
    ViewData["Title"] = "Donate";
}

<section class="section">
    <div class="container" style="max-width:720px;">
        <div class="card" style="border-radius:12px;">
            <div class="card-body">
                <h2 class="section-title" style="margin-top:0;">Donate</h2>
                <p class="text-muted">Make a secure donation to support relief efforts. Fields marked with * are required.</p>

                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert alert-success">@Model.StatusMessage</div>
                }

                @if (!string.IsNullOrEmpty(Model.TaxCertificateJson))
                {
                    <div class="alert alert-info">
                        <strong>Tax certificate generated:</strong>
                        <pre class="mb-0" style="white-space:pre-wrap;">@Model.TaxCertificateJson</pre>
                    </div>
                }

                <form method="post" class="mt-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label class="label">Full Name*</label>
                        <input class="input form-control w-100" asp-for="Input.FullName" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Email*</label>
                        <input class="input form-control w-100" type="email" asp-for="Input.Email" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Phone Number*</label>
                        <input class="input form-control w-100" type="tel" asp-for="Input.PhoneNumber" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Address*</label>
                        <input class="input form-control w-100" asp-for="Input.Address" />
                        <span asp-validation-for="Input.Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Organization Name (optional)</label>
                        <input class="input form-control w-100" asp-for="Input.OrganizationName" />
                        <span asp-validation-for="Input.OrganizationName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Donation Amount (ZAR)*</label>
                        <input class="input form-control w-100" type="number" asp-for="Input.Amount"
                               min="10" step="0.01" />
                        <span asp-validation-for="Input.Amount" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Which cause?*</label>
                        <select class="input form-select w-100" asp-for="Input.DisasterOrCause">
                            <option value="">General Fund</option>
                            <option value="KwaZulu-Natal Floods">KwaZulu-Natal Floods</option>
                            <option value="Western Cape Wildfires">Western Cape Wildfires</option>
                            <option value="Eastern Cape Drought">Eastern Cape Drought</option>
                        </select>
                    </div>

                    <div class="mb-3 form-check">
                        <input class="form-check-input" asp-for="Input.IsAnonymous" id="isAnon" />
                        <label class="form-check-label" for="isAnon">Donate anonymously</label>
                    </div>

                    <div class="mb-3">
                        <label class="label">Message (optional)</label>
                        <textarea class="input form-control w-100" asp-for="Input.Message"
                                  rows="3" maxlength="500"></textarea>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary-accent" type="submit">Donate Now</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}