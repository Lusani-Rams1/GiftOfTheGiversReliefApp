@page
@model Gift_of_the_Givers_Relief_App.Pages.Donators.TaxCertificateModel
@{
    ViewData["Title"] = "Tax Certificate";
}

<section class="section">
    <div class="container" style="max-width:720px;">
        <div class="card" style="border-radius:12px;">
            <div class="card-body">
                <h2 class="section-title" style="margin-top:0;">Tax Certificate</h2>

                <p class="text-muted">Request a tax certificate for a donation. This is a demo UI — no certificate will be generated.</p>

                <form method="post" class="mt-3">
                    <div class="mb-3">
                        <label class="label">Donation reference</label>
                        <input class="input form-control w-100" asp-for="Request.Reference" />
                    </div>

                    <div class="mb-3">
                        <label class="label">Email (used for donation)</label>
                        <input class="input form-control w-100" asp-for="Request.Email" type="email" />
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary-accent" type="submit">Request Certificate</button>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert alert-success mt-3" role="alert">@Model.Message</div>
                    }
                </form>
            </div>
        </div>
    </div>
</section>