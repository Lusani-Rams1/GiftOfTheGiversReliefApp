@page
@model Gift_of_the_Givers_Relief_App.Pages.Donators.TaxCertificateModel
@{
    ViewData["Title"] = "Tax Certificate";
}

<section class="section">
    <div class="container" style="max-width:720px;">
        <div class="card" style="border-radius:12px;">
            <div class="card-body">
                <h2 class="section-title" style="margin-top:0;">Tax Certificate</h2>
                <p class="text-muted">Enter your donation reference and the email used, and we'll generate your tax certificate.</p>

                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-success" role="alert">@Model.Message</div>
                }

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                }

                @if (Model.Certificate is not null)
                {
                    <div class="alert alert-info">
                        <h5 class="mb-3">Certificate Details</h5>
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Certificate Number</dt>
                            <dd class="col-sm-8">@Model.Certificate.CertificateNumber</dd>

                            <dt class="col-sm-4">Donor</dt>
                            <dd class="col-sm-8">@Model.Certificate.DonorName</dd>

                            <dt class="col-sm-4">Amount</dt>
                            <dd class="col-sm-8">R @Model.Certificate.Amount.ToString("N2")</dd>

                            <dt class="col-sm-4">Issued On</dt>
                            <dd class="col-sm-8">@Model.Certificate.IssuedOn.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

                            <dt class="col-sm-4">Note</dt>
                            <dd class="col-sm-8">@Model.Certificate.Message</dd>
                        </dl>
                    </div>
                }

                <form method="post" class="mt-3">
                    <div class="mb-3">
                        <label class="label">Donation Reference (Donation ID)*</label>
                        <input class="input form-control w-100" asp-for="Request.Reference" />
                        <span asp-validation-for="Request.Reference" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Email (used for donation)*</label>
                        <input class="input form-control w-100" asp-for="Request.Email" type="email" />
                        <span asp-validation-for="Request.Email" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary-accent" type="submit">Request Certificate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}