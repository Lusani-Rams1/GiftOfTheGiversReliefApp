<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a asp-page="/Index" class="brand">
            <img src="~/images/GiftofTheGivers_logo.png" alt="Gift of the Givers" class="brand-logo" />
            <span class="brand-name">Gift of the Givers</span>
        </a>

        <nav class="main-nav">
            <a asp-page="/Index">Home</a>
            <a asp-page="/Disasters/Details">Disasters</a>

            <div class="dropdown">
                <a class="dropdown-toggle" href="#" id="donateDropdown" data-bs-toggle="dropdown" aria-expanded="false">Donate</a>
                <ul class="dropdown-menu" aria-labelledby="donateDropdown">
                    <li><a class="dropdown-item" asp-page="/Donators/Donators_form">Donate</a></li>
                    <li><a class="dropdown-item" href="/Donators/TaxCertificate">Tax Certificate</a></li>
                </ul>
            </div>

            <a asp-page="/Volunteers/Volunteers_form">Volunteer</a>
            <a asp-page="/ContactUs">ContactUs</a>

            <a asp-page="/Account/Login" class="btn-login">Login</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        &copy; @DateTime.Now.Year Gift of the Givers Foundation & Prototype build (Gift Of The Givers)
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
