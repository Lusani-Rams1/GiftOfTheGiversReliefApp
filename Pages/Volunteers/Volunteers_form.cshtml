@page
@model Gift_of_the_Givers_Relief_App.Pages.Volonteers.Volonteers_formModel
@{
    ViewData["Title"] = "Volunteer";
}


<section class="section">
    <div class="container" style="max-width:720px;">
        <div class="card" style="border-radius:12px;">
            <div class="card-body">
                <h2 class="section-title" style="margin-top:0;">Become a Volunteer</h2>
                <p class="text-muted">
                    Create your volunteer account. We'll contact you with opportunities that match
                    your availability and skills.
                </p>
                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert alert-success">@Model.StatusMessage</div>
                }
                <form method="post" class="mt-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label class="label">Full Name*</label>
                        <input class="input form-control w-100" asp-for="Input.FullName" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Email*</label>
                        <input class="input form-control w-100" type="email" asp-for="Input.Email" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Phone Number*</label>
                        <input class="input form-control w-100" type="tel" asp-for="Input.PhoneNumber" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">City/Area*</label>
                        <input class="input form-control w-100" asp-for="Input.Location" />
                        <span asp-validation-for="Input.Location" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Which cause do you want to help with?*</label>
                        <select class="input form-select w-100" asp-for="Input.DisasterId">
                            <option value="">General Volunteering</option>
                            <option value="1">KwaZulu-Natal Floods</option>
                            <option value="2">Western Cape Wildfires</option>
                            <option value="3">Eastern Cape Drought</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="label">Availability*</label>
                        <select class="input form-select w-100" asp-for="Input.Availability">
                            <option value="Weekdays">Weekdays</option>
                            <option value="Weekends">Weekends</option>
                            <option value="Both">Both</option>
                            <option value="Flexible">Flexible</option>
                        </select>
                        <span asp-validation-for="Input.Availability" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Skills/Experience (optional)</label>
                        <textarea class="input form-control w-100" asp-for="Input.Skills" rows="3"
                                  maxlength="500"
                                  placeholder="e.g. first aid, driving, logistics, translation"></textarea>
                    </div>

                    <div class="mb-3 form-check">
                        <input class="form-check-input" asp-for="Input.HasOwnTransport" id="hasTransport" />
                        <label class="form-check-label" for="hasTransport">
                            I have my own transport
                        </label>
                    </div>

                    <div class="mb-3">
                        <label class="label">Message (optional)</label>
                        <textarea class="input form-control w-100" asp-for="Input.Message"
                                  rows="3" maxlength="500"></textarea>
                    </div>

                    <hr />

                    <h3 class="section-title" style="font-size:1.1rem;">Create your account</h3>

                    <div class="mb-3">
                        <label class="label">Password*</label>
                        <input class="input form-control w-100" type="password" asp-for="Input.Password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="label">Confirm Password*</label>
                        <input class="input form-control w-100" type="password" asp-for="Input.ConfirmPassword" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary-accent" type="submit">Sign Up to Volunteer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}