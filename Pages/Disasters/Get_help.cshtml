@page
@model Gift_of_the_Givers_Relief_App.Pages.Disasters.Get_helpModel
@{
    ViewData["Title"] = "Get Help";
}

<section class="section">
    <div class="container" style="max-width:720px;">
        <div class="card" style="border-radius:12px;">
            <div class="card-body">
                <h2 class="section-title" style="margin-top:0;">Get Help</h2>
                <p class="text-muted">If you or your community needs assistance, send us the details below and we'll reach out with next steps.</p>

                <form method="post" class="mt-3">
                    <div class="mb-3">
                        <label class="label">Full Name*</label>
                        <input class="input form-control w-100" type="text" name="FullName" required />
                    </div>

                    <div class="mb-3">
                        <label class="label">Email*</label>
                        <input class="input form-control w-100" type="email" name="Email" required />
                    </div>

                    <div class="mb-3">
                        <label class="label">Phone Number*</label>
                        <input class="input form-control w-100" type="tel" name="PhoneNumber" required />
                    </div>

                    <div class="mb-3">
                        <label class="label">City/Area*</label>
                        <input class="input form-control w-100" type="text" name="Location" required />
                    </div>

                    <div class="mb-3">
                        <label class="label">Which cause affected you?*</label>
                        <select class="input form-select w-100" name="DisasterId" required>
                            <option value="1">Other</option>
                            <option value="2">KwaZulu-Natal Floods</option>
                            <option value="3">Western Cape Wildfires</option>
                            <option value="4">Eastern Cape Drought</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="label">Message (optional)</label>
                        <textarea class="input form-control w-100" name="Message" maxlength="500"></textarea>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary-accent" type="submit">Get Help</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
