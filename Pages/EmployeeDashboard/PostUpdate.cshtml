@page
@model Gift_of_the_Givers_Relief_App.Pages.EmployeeDashboard.PostUpdateModel
@{
    ViewData["Title"] = "Post Update";
}

<section class="section">
    <h2 class="section-title">Post Update</h2>

    <div style="max-width:900px;margin:0 auto;background:#fff;padding:1.25rem;border-radius:8px;">
        <form method="post" class="form">
            <label class="label">Update title</label>
            <input class="input" asp-for="Input.Title" />

            <label class="label">Message</label>
            <textarea class="input" asp-for="Input.Message" rows="6"></textarea>

            <button class="button" type="submit">Publish (demo)</button>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div style="margin-top:1rem;color:var(--primary);font-weight:600;">@Model.StatusMessage</div>
            }
        </form>
    </div>

    <div style="margin-top:1rem;color:var(--text-muted);max-width:900px;margin-left:auto;margin-right:auto;">
        <p>Publishing here does not affect live data in this demo. In a full implementation this would save updates and notify subscribers.</p>
    </div>
</section>