@page
@model Gift_of_the_Givers_Relief_App.Pages.EmployeeDashboard.PostUpdateModel
@{
    ViewData["Title"] = "Post Update";
}

<section class="section">
    <div class="container" style="max-width:720px;">
        <div class="card" style="border-radius:12px;">
            <div class="card-body">
                <h2 class="section-title" style="margin-top:0;">Post Update</h2>
                <p class="text-muted">Publish a new update for the dashboard. Fields marked with * are required.</p>

                <form method="post" class="mt-3">
                    <div class="mb-3">
                        <label class="label">Update Title*</label>
                        <input class="input form-control w-100" asp-for="Input.Title" required />
                    </div>

                    <div class="mb-3">
                        <label class="label">Message*</label>
                        <textarea class="input form-control w-100" asp-for="Input.Message" rows="6" required></textarea>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary-accent" type="submit">Publish (demo)</button>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        <div class="mt-3 text-center" style="color:var(--primary);font-weight:600;">
                            @Model.StatusMessage
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</section>