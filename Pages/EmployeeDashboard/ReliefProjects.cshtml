@page
@model Gift_of_the_Givers_Relief_App.Pages.EmployeeDashboard.ReliefProjectsModel
@{
    ViewData["Title"] = "Relief Projects";
}

<section class="section">
    <h2 class="section-title">Relief Projects</h2>

    <div style="max-width:1000px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
        @foreach (var p in Model.SampleProjects)
        {
            <article class="disaster-card">
                <div class="disaster-thumb">@p.Region</div>
                <div class="disaster-body">
                    <h3>@p.Title</h3>
                    <p>@p.Summary</p>
                    <small style="color:var(--text-muted);">Started: @p.Started.ToShortDateString()</small>
                </div>
            </article>
        }
    </div>

    <div style="margin-top:1.5rem;color:var(--text-muted);max-width:1000px;margin-left:auto;margin-right:auto;">
        <p>These project cards are static placeholders for the demo. Implement data access in the real dashboard to list and manage projects.</p>
    </div>
</section>