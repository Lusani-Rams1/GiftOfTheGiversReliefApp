@page
@model Gift_of_the_Givers_Relief_App.Pages.EmployeeDashboard.IndexModel
@{
    ViewData["Title"] = "Employee Dashboard";
}

<section class="section">
    <div class="container" style="max-width:1100px;">
        <div class="d-flex align-items-center justify-content-between" style="gap:1rem;flex-wrap:wrap;">
            <div>
                <h2 class="section-title" style="margin:0;">Employee Dashboard</h2>
                <p class="text-muted" style="margin:0.25rem 0 0;">Manage relief projects, post updates and review volunteer signups (demo UI).</p>
            </div>

            <div class="d-flex" style="gap:.5rem;flex-wrap:wrap;">
                <a class="btn btn-outline-light" href="/">Return to site</a>
                <a class="btn btn-primary-accent" href="/EmployeeDashboard/PostUpdate">New update</a>
            </div>
        </div>

        <div class="row" style="margin-top:1.25rem;gap:1rem;">
            <div class="col-lg-4">
                <div class="card" style="border-radius:12px;">
                    <div class="card-body">
                        <h5 style="margin:0 0 .5rem 0;">Quick actions</h5>

                        <div class="d-grid gap-2" style="margin-top:.5rem;">
                            <a class="btn btn-primary-accent" href="/EmployeeDashboard/ReliefProjects">Relief Projects</a>
                            <a class="btn btn-primary-accent" href="/EmployeeDashboard/PostUpdate">Post Update</a>
                            <a class="btn btn-primary-accent" href="/EmployeeDashboard/VolunteerSignups">Volunteer Signups</a>
                        </div>

                        <hr />

                        <h6 style="margin:0 0 .25rem 0;color:var(--text-muted);">Summary (demo)</h6>
                        <ul style="padding-left:1.1rem;margin:0;color:var(--text-muted);">
                            <li><strong>Active projects:</strong> 3</li>
                            <li><strong>Recent signups:</strong> 8</li>
                            <li><strong>Pending updates:</strong> 1</li>
                        </ul>
                    </div>
                </div>

                <div class="card" style="border-radius:12px;margin-top:1rem;">
                    <div class="card-body">
                        <h6 style="margin:0 0 .5rem 0;">Notifications</h6>
                        <div style="color:var(--text-muted);font-size:.95rem;">
                            <p style="margin:.25rem 0 0;">No critical notifications — this is a demo dashboard.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card" style="border-radius:12px;">
                    <div class="card-body">
                        <h5 style="margin:0 0 .75rem 0;">Recent activity</h5>

                        <div style="display:flex;flex-direction:column;gap:.75rem;">
                            <div style="padding:.75rem;border-radius:8px;background:var(--light-bg);">
                                <div style="font-weight:700;">Food & Shelter Relief — KwaZulu-Natal</div>
                                <div style="color:var(--text-muted);font-size:.95rem;margin-top:.25rem;">Project started 14 days ago. Supplies dispatched to three distribution points.</div>
                            </div>

                            <div style="padding:.75rem;border-radius:8px;background:var(--light-bg);">
                                <div style="font-weight:700;">Volunteer signups spike</div>
                                <div style="color:var(--text-muted);font-size:.95rem;margin-top:.25rem;">8 new volunteer signups in the last week. Review in Volunteer Signups.</div>
                            </div>

                            <div style="padding:.75rem;border-radius:8px;background:var(--light-bg);">
                                <div style="font-weight:700;">Draft update available</div>
                                <div style="color:var(--text-muted);font-size:.95rem;margin-top:.25rem;">There is one unpublished update. Use Post Update to publish (demo).</div>
                            </div>
                        </div>

                        <div style="margin-top:1rem;">
                            <a class="btn btn-primary-accent" href="/EmployeeDashboard/PostUpdate">Create new update</a>
                        </div>
                    </div>
                </div>

                <div class="card" style="border-radius:12px;margin-top:1rem;">
                    <div class="card-body">
                        <h6 style="margin:0 0 .5rem 0;">Manage</h6>
                        <div class="row" style="gap:.5rem;">
                            <div class="col-md-6">
                                <div style="padding:.6rem;border-radius:8px;background:#fff;border:1px solid #eee;">
                                    <a href="/EmployeeDashboard/ReliefProjects" style="text-decoration:none;color:var(--primary);font-weight:700;">Relief Projects ?</a>
                                    <div style="color:var(--text-muted);font-size:.9rem;margin-top:.25rem;">View and manage relief projects.</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div style="padding:.6rem;border-radius:8px;background:#fff;border:1px solid #eee;">
                                    <a href="/EmployeeDashboard/VolunteerSignups" style="text-decoration:none;color:var(--primary);font-weight:700;">Volunteer Signups ?</a>
                                    <div style="color:var(--text-muted);font-size:.9rem;margin-top:.25rem;">Browse recent signups and contact volunteers.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>